# secrets and generated config
*.age
*.key
.env
.env.*
!env.example
secrets/
rendered/
deploy/**/*.tfstate
deploy/**/*.tfstate.*
deploy/**/.terraform/
*.tfvars
!*.tfvars.example

# runtime data
data/*
# Checked-in reference data lives here too, and the directory-wide exclusion above swallowed it once:
# the model lifecycle table was untracked locally and only CI noticed. tests/test_model_lifecycle.py
# asserts this file is tracked, so the next silent exclusion fails a test instead of a pipeline.
!data/model-lifecycle.json
backups/
logs/
exports/
models/

# python
__pycache__/
*.pyc
.venv/

# The fixture corpus bytes. Fetched, not committed: they are 3.3 MB of someone else's documents, the
# lockfile records exactly which bytes a run used, and `fetch_corpus.py --verify` is the check that the
# bytes on disk are the ones the last run used. The manifest and the lockfile ARE committed, because
# those are the parts a reader needs.
fixtures/corpus/*.htm
fixtures/corpus/*.pdf
